{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlquilaYa ERP",
  "version": "0.1.0",
  "identifier": "com.alquilaya.erp.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Instalar AlquilaYa ERP",
        "width": 1050,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
