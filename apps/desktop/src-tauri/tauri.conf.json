{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlquilaYa ERP",
  "version": "0.1.0",
  "identifier": "com.contract.system",
  "build": {
    "beforeDevCommand": "cd ../web && pnpm dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://REPLACE-WITH-YOUR-VERCEL-URL.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "AlquilaYa ERP",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
