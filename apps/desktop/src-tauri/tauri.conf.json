{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlquilaYa ERP",
  "version": "0.1.0",
  "identifier": "com.contract.system",
  "build": {
    "beforeDevCommand": "cd ../web && pnpm dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://alquilaloya.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "AlquilaYa ERP",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "AlquilaYa ERP",
        "languages": ["Spanish"],
        "customLanguageFiles": {
          "Spanish": "installer-languages/Spanish.nsh"
        },
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
