# === Supabase / PostgreSQL ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_system
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/contract_system

# === Supabase (Auth / Storage / Client) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Redis / BullMQ ===
REDIS_URL=redis://localhost:6379

# === Supabase Storage Bucket ===
SUPABASE_STORAGE_BUCKET=contracts

# === Seguridad / sesión (Fase 7-8) ===
# Clave de cifrado de credenciales de conectores (>=24 bytes). OBLIGATORIA en prod.
CONNECTOR_ENCRYPTION_KEY=

# === Supabase Auth (Fase 8) ===
# Clave anónima/publishable para validar tokens (no es la service key).
SUPABASE_ANON_KEY=
# Contraseña inicial común que asigna el script de aprovisionamiento a los usuarios.
# (node scripts/seed-supabase-users.mjs) — luego se puede cambiar por usuario.
SUPABASE_USERS_PASSWORD=

# === Integration secrets (to be filled in later phases) ===
# GOOGLE_FORMS_...
# GMAIL_...
# WHATSAPP_...
