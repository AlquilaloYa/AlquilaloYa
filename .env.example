# === Supabase / PostgreSQL ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_system
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/contract_system

# === Supabase (Auth / Storage / Client) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Redis / BullMQ ===
REDIS_URL=redis://localhost:6379

# === Supabase Storage Bucket ===
SUPABASE_STORAGE_BUCKET=contracts

# === Seguridad / sesión (Fase 7-8) ===
# Clave de cifrado de credenciales de conectores (>=24 bytes, alta entropia). OBLIGATORIA.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si falta, el cifrado/descifrado falla-cerrado (no hay clave por defecto).
CONNECTOR_ENCRYPTION_KEY=
# Clave ANTERIOR, solo durante una rotacion (permite descifrar datos viejos).
# Dejar vacia en operacion normal. Ver packages/db/scripts/rotate-credentials.ts
CONNECTOR_ENCRYPTION_KEY_PREVIOUS=

# === Supabase Auth (Fase 8) ===
# Clave anónima/publishable para validar tokens (no es la service key).
SUPABASE_ANON_KEY=
# SEC-015: exige MFA (AAL2) a ADMIN/DEVELOPER. Activar SOLO cuando esos usuarios
# ya hayan enrolado un factor TOTP (si no, quedan sin acceso). true | false.
MFA_ENFORCE=false
# Contraseña inicial común que asigna el script de aprovisionamiento a los usuarios.
# (node scripts/seed-supabase-users.mjs) — luego se puede cambiar por usuario.
SUPABASE_USERS_PASSWORD=

# === Integration secrets (to be filled in later phases) ===
# GOOGLE_FORMS_...
# GMAIL_...
# WHATSAPP_...

# === Google Calendar (Agenda personal por usuario) ===
# Crea un OAuth Client ID (tipo "Web application") en Google Cloud Console.
# Anade como URI de redireccion autorizada el GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/agenda/google/callback
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events

# Token para el gateway de mensajes entrantes (/api/webhooks/mensajes)
MESSAGING_WEBHOOK_TOKEN=

# === Sitio web AlquilaYa (panel "Contenido Web") ===
# Base de la API de AlquilaYa y credenciales de la cuenta admin del sitio.
ALQUILAYA_API_URL=http://localhost:4000
ALQUILAYA_ADMIN_EMAIL=admin@example.com
ALQUILAYA_ADMIN_PASSWORD=

# Conectores de mensajería (Fase 3) — todos opcionales hasta que configures canales
META_APP_SECRET=
META_VERIFY_TOKEN=
# Salida real a WhatsApp (además del webhook) — opcional, para responder por API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cron de automatizaciones (Vercel Cron) — genera uno fuerte y pégalo también en Vercel
CRON_SECRET=
